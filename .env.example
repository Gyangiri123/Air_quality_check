# ==============================================================================
# Atmosphere Analyzer (AirWatch Pro) - Frontend Environment Variables
# ==============================================================================
# All variables are optional. If keys are omitted, the application automatically
# falls back to realistic simulation and mock data for seamless development.
# ==============================================================================

# Backend API URL (Leave blank for relative paths in Vercel or point to local backend)
# Example for local FastAPI backend: http://localhost:8000
VITE_API_BASE_URL=

# API Timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# External API Keys (Optional)
VITE_NASA_API_KEY=
VITE_EPA_API_KEY=
VITE_OPENAQ_API_KEY=
VITE_OPENWEATHER_API_KEY=

# Feature Toggles (true / false)
VITE_ENABLE_SATELLITE_DATA=true
VITE_ENABLE_HISTORICAL_DATA=true
VITE_ENABLE_FORECASTS=true
VITE_ENABLE_ALERTS=true

# Development & Logging (logLevel: 'debug' | 'info' | 'warn' | 'error')
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=warn

# Default Map View Settings (Default: Delhi, India)
VITE_DEFAULT_MAP_CENTER_LAT=28.6139
VITE_DEFAULT_MAP_CENTER_LNG=77.2090
VITE_DEFAULT_MAP_ZOOM=10

# Data Refresh Intervals (in seconds)
VITE_CURRENT_DATA_REFRESH_INTERVAL=300
VITE_HISTORICAL_DATA_REFRESH_INTERVAL=3600
VITE_LOCATIONS_CACHE_DURATION=1800

